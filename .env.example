# Local-only defaults. Copy to .env and replace values before shared deployment.
COMPOSE_PROJECT_NAME=catalogops

# PostgreSQL / pgvector
POSTGRES_USER=catalogops
POSTGRES_PASSWORD=local-catalogops-change-me
POSTGRES_DB=catalogops
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://catalogops:local-catalogops-change-me@postgres:5432/catalogops

# Redis task queue
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# API
API_PORT=8000
API_WORKERS=2
LOG_LEVEL=info
APP_ENV=development
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
AUTO_MATCH_THRESHOLD=0.85
REVIEW_THRESHOLD=0.55
CATALOGOPS_MODEL_BACKEND=baseline
CATALOGOPS_AUTO_SEED=true
# `make dvc-repro` creates this directory; the API safely fits in-memory when absent.
MATCHER_ARTIFACT_PATH=/app/artifacts/baseline
MATCHER_ARTIFACT_DIR=./artifacts

# Web (compiled into the browser bundle; never put secrets in VITE_* values)
WEB_PORT=8080
VITE_API_URL=/api/v1
